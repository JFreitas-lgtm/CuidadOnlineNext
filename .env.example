# Copie a URI em Atlas > Connect > Drivers, substitua <db_password>
# e use cuidadonline como nome do banco.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@HOST/cuidadonline?retryWrites=true&w=majority
# Opcional: use apenas se o DNS local recusar consultas SRV do Atlas.
MONGODB_DNS_SERVERS=

# Obrigatorio em producao. Em desenvolvimento existe um fallback somente local.
AUTH_SECRET=gere-uma-chave-segura-com-openssl-rand-base64-32

# Opcionais: quando preenchidas, o seed cria ou atualiza o administrador.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
